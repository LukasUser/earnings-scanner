# Copy to .env and fill in. .env is git-ignored.

# Enables the per-company AI briefs and the daily overview. Leave empty to skip them.
ANTHROPIC_API_KEY=

# SEC EDGAR asks automated clients to identify themselves: "Your Name your@email.com"
SEC_USER_AGENT=

# Daily email. For Gmail, SMTP_PASSWORD is an app password (Google Account → Security →
# 2-Step Verification → App passwords), not your normal password. Leave empty to skip email.
EMAIL_TO=
SMTP_USER=
SMTP_PASSWORD=
